{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-mobile-phone-waterfall-orchestrator",
  "description": "Find mobile phone numbers by chaining your own Prospeo, Lusha, ContactOut, and FullEnrich keys.",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-mobile-phone-waterfall-orchestrator",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-mobile-phone-waterfall-orchestrator",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "PROSPEO_API_KEY",
          "description": "Optional. Your Prospeo API key.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "LUSHA_API_KEY",
          "description": "Optional. Your Lusha API key (V3).",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "CONTACTOUT_API_KEY",
          "description": "Optional. Your ContactOut API token.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "FULLENRICH_API_KEY",
          "description": "Optional. Your FullEnrich API key.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
